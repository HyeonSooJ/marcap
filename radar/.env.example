# 이 파일을 .env로 복사한 뒤 값을 채워서 사용하세요. (.env는 git에 커밋되지 않습니다)
# 로컬 실행 시: `set -a && source radar/.env && set +a` 후 스크립트 실행
# GitHub Actions 실행 시: 저장소 Settings > Secrets and variables > Actions 에 동일한 이름으로 등록

# https://opendart.fss.or.kr (회원가입 -> 오픈API 이용신청, 무료)
DART_API_KEY=

# https://developers.naver.com/apps (애플리케이션 등록 -> 검색 API, 무료)
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=

# https://console.anthropic.com (LLM 원인 해설 리포트 생성용)
ANTHROPIC_API_KEY=
