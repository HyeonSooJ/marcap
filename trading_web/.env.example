# 한국투자증권 KIS Developers 에서 발급받은 값을 입력하고, 파일명을 .env 로 바꿔서 사용하세요.
# .env 는 git 에 올라가지 않습니다 (.gitignore).

# vps = 모의투자 (기본, 권장) / prod = 실전투자 (실제 돈으로 체결!) / demo = API 없이 가상 시뮬레이션
KIS_ENV=vps

KIS_APP_KEY=
KIS_APP_SECRET=
# 계좌번호 8자리-상품코드 2자리 (예: 50123456-01)
KIS_ACCOUNT=

# P: 개인, B: 법인
KIS_CUSTTYPE=P
